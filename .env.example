# Plain configuration for the BLT orchestrator. Never commit .env.
# Passwords and keys are NOT here: they are files in secrets/ (git-ignored, directory mode 700):
#   secrets/blt_pg_password     password of the read-only Postgres role blt_mcp
#   secrets/minio_mcp_secret    secret of the read-only MinIO user (MINIO_ACCESS_KEY)
#   secrets/opencode_api_key    key of the AI provider used by the tooling
# The application secrets live in blt-project/secrets (see blt-project/README.md).

# AI tooling (same provider as ANA)
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_TIMEOUT=90
OPENCODE_REASONING_EFFORT=none

# React client URL used in manual smoke tests
WEB_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000

# MCP — PostgreSQL read-only. Create the role with mcp_servers/postgres-readonly.sql
# (it can read only tasks_task, specs_spec and the mcp_users view).
BLT_PG_HOST=127.0.0.1
BLT_PG_PORT=5433
BLT_PG_NAME=blt
BLT_PG_USER=blt_mcp

# MCP — MinIO read-only. Use the read-only user created by minio-init
# (MINIO_RO_ACCESS_KEY in blt-project/.env), never the root keys.
MINIO_ENDPOINT=http://127.0.0.1:9200
MINIO_ACCESS_KEY=bltmcp-ro
MINIO_BUCKET=blt-media

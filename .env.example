# Chaves usadas durante o desenvolvimento do BLT.
# Copie para .env e preencha. Nunca versione o .env.

# Ferramentas de IA (mesmo provider do ANA)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_TIMEOUT=90
OPENCODE_REASONING_EFFORT=none

# Postgres opcional para inspeção manual do banco do compose
POSTGRES_DB=blt
POSTGRES_USER=blt
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# URL do cliente React usada em smoke tests manuais
WEB_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000

# MCP — PostgreSQL read-only. Create the role with mcp_servers/postgres-readonly.sql.
BLT_PG_HOST=127.0.0.1
BLT_PG_PORT=5433
BLT_PG_NAME=blt
BLT_PG_USER=blt_mcp
BLT_PG_PASSWORD=

# MCP — MinIO read-only (profile storage do compose).
MINIO_ENDPOINT=http://127.0.0.1:9200
MINIO_ACCESS_KEY=bltminio
MINIO_SECRET_KEY=
MINIO_BUCKET=blt-media

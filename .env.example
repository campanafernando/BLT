# Keys used while developing BLT.
# Copy to .env and fill it. Never commit the .env file.

# AI tooling (same provider as ANA)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_TIMEOUT=90
OPENCODE_REASONING_EFFORT=none

# Optional Postgres access for manual inspection of the Compose database
POSTGRES_DB=blt
POSTGRES_USER=blt
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# React client URL used in manual smoke tests
WEB_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8000

# MCP — PostgreSQL read-only. Create the role with mcp_servers/postgres-readonly.sql
# (it can read only tasks_task, specs_spec and the mcp_users view).
BLT_PG_HOST=127.0.0.1
BLT_PG_PORT=5433
BLT_PG_NAME=blt
BLT_PG_USER=blt_mcp
BLT_PG_PASSWORD=

# MCP — MinIO read-only. Use the read-only user created by minio-init
# (MINIO_RO_ACCESS_KEY / MINIO_RO_SECRET_KEY in blt-project/.env), never the root keys.
MINIO_ENDPOINT=http://127.0.0.1:9200
MINIO_ACCESS_KEY=bltmcp-ro
MINIO_SECRET_KEY=
MINIO_BUCKET=blt-media
